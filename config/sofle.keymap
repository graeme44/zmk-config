#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// Configure scroll speed before including pointing header (default: 10, higher = faster)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };

        password_macro: password_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>
                     , <&macro_tap &kp BSLH>
                     , <&macro_release &kp LGUI &kp LSHFT>;
        };

        // Layer indicator macro for LOWER layer (bright green)
        lower_layer: lower_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mo 1>
                     , <&macro_tap &rgb_ug RGB_COLOR_HSB(120,100,100)>
                     , <&macro_pause_for_release>
                     , <&macro_release &mo 1>
                     , <&macro_tap &rgb_ug RGB_COLOR_HSB(0,100,30)>;
        };

        // Layer indicator macro for RAISE layer (bright blue)
        raise_layer: raise_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mo 2>
                     , <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,100)>
                     , <&macro_pause_for_release>
                     , <&macro_release &mo 2>
                     , <&macro_tap &rgb_ug RGB_COLOR_HSB(0,100,30)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Anne Pro 2 "Mac.GC" equivalent base layer.
            // Top-right corner = Backspace and the key below it = backslash, matching the
            // Anne's rightmost column. Ctrl sits on the Caps position, as on the Anne.
            //
            // Backspace and Space take the two forward thumb keys, one per hand, so the
            // type/backspace/retype cycle alternates thumbs. Enter moves to the right thumb
            // where the Anne trained it, pushing RAISE onto the grid key it vacates (RAISE
            // only carries Bluetooth and the numpad, so the longer reach is cheap). Right
            // Ctrl is dropped as redundant. The top-right Backspace is kept during the
            // transition so the old pinky habit still works; make it DEL once it fades.
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PASS  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | CTRL | ALT | CMD  | LOWER| BKSPC  |  | SPACE | ENTER| RAISE | ALT   | GUI  |

            bindings = <
&kp ESC           &kp N1  &kp N2            &kp N3    &kp N4        &kp N5                           &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB           &kp Q   &kp W             &kp E     &kp R         &kp T                            &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSLH
&kp LEFT_CONTROL  &kp A   &kp S             &kp D     &kp F         &kp G                            &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &kp Z   &kp X             &kp C     &kp V         &kp B   &kp C_MUTE    &password_macro      &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                          &kp LEFT_CONTROL  &kp LALT  &kp LEFT_WIN  &lower_layer   &kp BSPC      &kp SPACE  &kp RET        &raise_layer  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&scroll_encoder SCRL_DOWN SCRL_UP>;
        };

        lower_layer {
            // Anne Pro 2 "Mac.GC" Fn1 layer: ` on Esc, F-keys over the numbers, Del on the
            // Backspace corner, HJKL arrows, PgUp/PgDn on ;/', media on A/S/D (Next/Play/Prev —
            // Anne order), volume on Z/X, Ins/Del on ./ and Enter-on-Space / Bksp-on-Cmd.
            // The Anne's physical - = [ ] keys don't exist on the Sofle, so they live here on U I O P.
            // ------------------------------------------------------------------------------------------------------------
            // |   `   | F1  | F2  |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  DEL  |
            // |       | F11 | F12 | RGBt | RGBd | RGBu |                   | RGBe |   -   |   =   |  [   |   ]   |       |
            // |       | NXT | PLY | PRV  |      |      |                   |  <-  |   v   |   ^   |  ->  | PGUP  | PGDN  |
            // |       | V-  | V+  |      |      |      |        |  |       | HOME |  END  |       | INS  |  DEL  |       |
            //               |     |      | BKSP |(held)|        |  | ENTER |      |       |       |      |

            bindings = <
&kp GRAVE  &kp F1        &kp F2            &kp F3           &kp F4           &kp F5                            &kp F6           &kp F7     &kp F8     &kp F9     &kp F10    &kp DEL
&trans     &kp F11       &kp F12           &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI                   &rgb_ug RGB_EFF  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &trans
&trans     &kp C_NEXT    &kp C_PLAY_PAUSE  &kp C_PREV       &trans           &trans                            &kp LEFT         &kp DOWN   &kp UP     &kp RIGHT  &kp PG_UP  &kp PG_DN
&trans     &kp C_VOL_DN  &kp C_VOL_UP      &trans           &trans           &trans           &trans    &trans  &kp HOME         &kp END    &trans     &kp INS    &kp DEL    &trans
                         &trans            &trans           &kp BSPC         &trans           &trans    &kp RET  &trans           &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            // Anne Pro 2 "Mac.GC" Fn2 layer: BT devices on 1-5, WASD-style arrows on the left
            // hand, right-hand numpad (789 / 456 / 123 on O P [ rows, 0 on Space), Caps on G,
            // RGB cluster on Z-V kept from the previous Sofle layout, USB/BLE output toggles.
            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |  BLE |  USB |       | RGBe | RGBt  |EP_TOG |
            // |     |      |  ^   |       |       |      |                |      |      |       | KP7  |  KP8  |  KP9  |
            // |     |  <-  |  v   |  ->   |       | CAPS |                |      |      |       | KP4  |  KP5  |  KP6  |
            // |     | RGBd | RGBt | RGBu  | RGBe  |      |      |  |      |      |      |  KP1  | KP2  |  KP3  |       |
            //              |      |       |       |      |      |  |  KP0 |      |      |       |      |
            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                    &out OUT_BLE  &out OUT_USB  &trans     &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &ext_power EP_TOG
&trans      &trans           &kp UP           &trans           &trans           &trans                          &trans        &trans        &trans     &kp KP_N7        &kp KP_N8        &kp KP_N9
&trans      &kp LEFT         &kp DOWN         &kp RIGHT        &trans           &kp CLCK                        &trans        &trans        &trans     &kp KP_N4        &kp KP_N5        &kp KP_N6
&trans      &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &trans        &trans    &trans  &trans        &trans        &kp KP_N1  &kp KP_N2        &kp KP_N3        &trans
                             &trans           &trans           &trans           &trans        &trans    &kp KP_N0  &trans     &trans        &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
    };
};

/*
 * TEST ONLY (experiment/builtin-screen): 128x64 panel geometry.
 * The Sofle shield hard-codes 128x32 (multiplex-ratio 31, com-sequential).
 * This lives in the keymap because config overlays are processed BEFORE the
 * shield, so the `oled` label does not exist yet at that point.
 */
&oled {
    height = <64>;
    multiplex-ratio = <63>;
    /delete-property/ com-sequential;
};
